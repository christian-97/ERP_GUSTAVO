{
  "name": "sazon-api",
  "version": "1.0.0",
  "description": "API REST de AdminRest con Cloudflare Workers y D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute sazon-db --remote --file=schema.sql",
    "d1:init:local": "wrangler d1 execute sazon-db --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
